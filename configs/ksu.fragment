# ============================================================
# SukiSU-Nova（builtin-new）配置片段 —— cezanne 4.14.186 非 GKI
# 仅在 enable_ksu=true 时应用。
# 注意：build.sh 的片段解析器只认 CONFIG_X=y/n，# 开头的行被当注释跳过，
#       所以关符号必须写成 CONFIG_X=n，不能写 '# CONFIG_X is not set'。
# builtin-new 使用 TAMPER_SYSCALL_TABLE（兼容 Clang CFI、专为 3.0~4.14），
# 无需 KPROBES 和 KALLSYMS_ALL（保持与原厂 base.config 一致），
# 无需手工改内核源码；KPM 在 <5.10 自动编出；SUSFS 暂关。
# ============================================================

CONFIG_KSU=y
CONFIG_KSU_TAMPER_SYSCALL_TABLE=y
CONFIG_KSU_LSM_SECURITY_HOOKS=y
CONFIG_KSU_SUSFS=n
CONFIG_KPM=n

CONFIG_EXT4_FS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
