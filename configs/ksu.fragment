# ============================================================
# SukiSU-Nova（builtin）配置片段 —— cezanne 4.14.186 非 GKI
# 仅在 enable_ksu=true 时应用。
# 注意：build.sh 的片段解析器只认 CONFIG_X=y/n，# 开头的行被当注释跳过，
#       所以关符号必须写成 CONFIG_X=n，不能写 '# CONFIG_X is not set'。
# SukiSU 非 GKI 要求 KALLSYMS_ALL=y（会改 module_layout CRC，vendor .ko
# 靠 relax_modversions 强行加载；守卫已把 KALLSYMS_ALL 移出关键项）。
# SUSFS 暂关：内核侧 susfs 文件/补丁待加，先出能用的 SukiSU。
# ============================================================

CONFIG_KSU=y
CONFIG_KSU_SUSFS=n
CONFIG_KPROBES=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

CONFIG_EXT4_FS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y