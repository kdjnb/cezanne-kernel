# ============================================================
# SukiSU-Nova（builtin，自带 SUSFS）配置片段 —— cezanne 4.14.186 非 GKI
# 仅在 enable_ksu=true 时应用。
# SukiSU 非 GKI 要求 KALLSYMS_ALL=y（会改 module_layout CRC，vendor .ko
# 靠 relax_modversions 强行加载；守卫已把 KALLSYMS_ALL 移出关键项）。
# ============================================================

CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KPROBES=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

CONFIG_EXT4_FS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y

# CONFIG_DEBUG_INFO is not set